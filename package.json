{
  "name": "wieszka-antivirus",
  "private": true,
  "version": "1.0.0",
  "description": "Wieszka Antivirus Ultimate",
  "author": "Wieszka Security",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "app:package": "npx vite build && electron-packager . WieszkaAntivirus --platform=win32 --arch=x64 --out=out --overwrite",
    "dist": "npm run build && npx electron-builder",
    "electron:dev": "npm run build && electron .",
    "clean": "rm -rf dist server.js release",
    "service:install": "npx tsx install-service.ts",
    "service:uninstall": "npx tsx uninstall-service.ts",
    "build:all": "npm run package && \"C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe\" antywirus_setup.iss",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.wieszka.antivirus",
    "productName": "Wieszka Antivirus Ultimate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-windows": "^1.0.0-beta.8",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
