{
  "appId": "com.wieszka.antivirus",
  "productName": "Wieszka Antivirus Ultimate",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron-main.js",
    "package.json"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true
  }
}
